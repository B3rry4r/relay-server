# Owner secret (the password for POST /api/auth/login). Prefer the hash:
#   printf '%s' 'your-long-secret' | node scripts/relay-auth hash-secret
AUTH_TOKEN_HASH=
# ...or a plaintext AUTH_TOKEN (>= 16 chars, deprecated):
# AUTH_TOKEN=
# Browser origins allowed to call the API (relay-web):
RELAY_ALLOWED_ORIGINS=http://localhost:5173
PORT=3000
WORKSPACE=/workspace
